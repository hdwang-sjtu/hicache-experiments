+        raise HTTPException(status_code=404, detail="HiCache 实验接口未启用")
+    if request.client is None or request.client.host not in ("127.0.0.1", "::1"):
+        raise HTTPException(status_code=403, detail="实验接口只接受本机请求")
+    parallel = get_parallel()
+    if parallel.tp_size != 1 or parallel.pp_size != 1 or parallel.dp_size != 1:
+        raise HTTPException(status_code=400, detail="实验接口仅支持 TP=PP=DP=1")
+    try:
+        obj = HiCacheExperimentReqInput(**(await request.json()))
+        if obj.action not in ("inspect", "demote") or not obj.prefix_ids:
+            raise ValueError("需要 inspect/demote 操作和非空 prefix_ids")
+        if not isinstance(obj.prefix_ids, list) or any(
+            type(token) is not int or token < 0 for token in obj.prefix_ids
+        ):
+            raise ValueError("prefix_ids 必须是非负整数列表")
+    except (TypeError, ValueError) as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    result = await _global_state.tokenizer_manager.hicache_experiment(obj)
+    return ORJSONResponse(msgspec_to_builtins(result))
