+@unittest.skipUnless(torch.cuda.is_available(), "cache fixtures need CUDA")
+class TestHiCacheExperiment(CustomTestCase):
+    """防止定向逐出破坏分裂后的 host 索引、引用和 allocator 账目。"""
+
+    @staticmethod
+    def _fixture(*, branching=False):
+        cache, allocator, _ = build_fixture(
+            CacheConfig(kv_size=64, num_layers=2), tree_core_backend="python"
+        )
+        tokens = list(range(1, 13))
+        indices = allocator.alloc(len(tokens))
+        # 与真实 serving 一致：树内存 array，实验接口接收 HTTP list。
+        cache.insert(InsertParams(key=RadixKey(array("q", tokens)), value=indices))
+        if branching:
+            branch = tokens[:8] + [31, 32, 33, 34]
+            branch_indices = torch.cat([indices[:8], allocator.alloc(4)])
+            cache.insert(
+                InsertParams(key=RadixKey(array("q", branch)), value=branch_indices)
+            )
+
+        # 使用真实树、组件和 device allocator；只替代不涉及搬运的 host 槽位管理。
+        stack = list(cache.tree_core.root_node.children.values())
+        offset = 0
+        while stack:
+            node = stack.pop()
+            cache.tree_core.commit_backup(
+                node.id,
+                torch.arange(offset, offset + len(node.key), dtype=torch.int64),
+                {},
+            )
+            cache.tree_core.mark_write_through_pending([node.id], ack_id=node.id)
+            cache.tree_core.finish_write_through([node.id], ack_id=node.id)
+            offset += len(node.key)
+            stack.extend(node.children.values())
+
+        def host_available():
+            return 128 - sum(
+                len(n.component_data[ComponentType.FULL].host_value)
+                for n in cache.tree_core._node_arena.values()
+                if n.parent is not None
+                and n.component_data[ComponentType.FULL].host_value is not None
+            )
+
+        cache.cache_controller = SimpleNamespace(
+            write_policy="write_through",
+            has_inflight_device_transfers=lambda: False,
+            mem_pool_host=SimpleNamespace(
+                size=128, size_per_token=16, available_size=host_available
+            ),
+        )
+        cache.host_memory_mode = "cache"
+        cache.tree_core.set_hicache_enabled()
+        return cache, allocator, tokens
+
+    def test_http_list_inspection_matches_serving_array_keys(self):
+        """回归：空树查询成功，但首次 Prefill 后 list 查询撞上 array 树键会崩溃。"""
+        cache, allocator, tokens = self._fixture()
+        available = allocator.available_size()
+        state = cache.experiment_control(tokens[:8], action="inspect")
+        self.assertEqual(state["matched_tokens"], 8)
+        self.assertEqual(state["device_tokens"], 8)
+        self.assertEqual(state["host_backed_tokens"], 8)
+        self.assertTrue(state["backup_complete"])
+        self.assertEqual(allocator.available_size(), available)
+
+    def test_split_suffix_demotion_preserves_host_and_is_idempotent(self):
+        cache, allocator, tokens = self._fixture()
+        before = cache.experiment_control(tokens[:8], action="inspect")
+        available = allocator.available_size()
+        state = cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(state["device_tokens"], 0)
+        self.assertEqual(state["host_hit_tokens"], 8)
+        self.assertEqual(state["host_backed_tokens"], 8)
+        self.assertEqual(state["host_free_tokens"], before["host_free_tokens"])
+        self.assertEqual(state["demoted_tokens"], 12)  # 包含 S₀，不仅是 P。
+        self.assertEqual(allocator.available_size() - available, 12)
+        match = cache.match_prefix(MatchPrefixParams(key=RadixKey(array("q", tokens))))
+        self.assertEqual(match.host_hit_length, 12)
+        self.assertEqual(match.device_prefix_len, 0)
+        state = cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(state["demoted_tokens"], 0)
+        self.assertEqual(allocator.available_size() - available, 12)
+
+    def test_locked_or_pending_branch_cannot_be_freed(self):
+        cache, allocator, tokens = self._fixture()
+        end = cache.match_prefix(
+            MatchPrefixParams(key=RadixKey(array("q", tokens)))
+        ).best_match_node
+        lock = cache.inc_lock_ref(end).to_dec_params()
+        available = allocator.available_size()
+        with self.assertRaisesRegex(ValueError, "引用"):
+            cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(allocator.available_size(), available)
+        cache.dec_lock_ref(end, lock)
+        cache.ongoing_write_through[123] = object()
+        with self.assertRaisesRegex(ValueError, "尚未完成"):
+            cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(allocator.available_size(), available)
+
+    def test_unbacked_suffix_is_rejected_before_any_free(self):
+        cache, allocator, tokens = self._fixture()
+        cache.experiment_control(tokens[:8], action="inspect")  # 先在 P 处拆分。
+        end = cache.match_prefix(
+            MatchPrefixParams(key=RadixKey(array("q", tokens)))
+        ).best_match_node
+        cache.tree_core.node_by_id(end).component_data[
+            ComponentType.FULL
+        ].host_value = None
+        available = allocator.available_size()
+        with self.assertRaisesRegex(ValueError, "后缀"):
+            cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(allocator.available_size(), available)
+        self.assertEqual(
+            cache.experiment_control(tokens[:8], action="inspect")["device_tokens"], 8
+        )
+
+    def test_shared_branch_is_not_partially_demoted(self):
+        cache, allocator, tokens = self._fixture(branching=True)
+        available = allocator.available_size()
+        with self.assertRaisesRegex(ValueError, "额外共享分支"):
+            cache.experiment_control(tokens[:8], action="demote")
+        self.assertEqual(allocator.available_size(), available)
+
+
