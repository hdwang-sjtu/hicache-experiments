+    def experiment_control(self, prefix_ids: list[int], *, action: str) -> dict:
+        """Scheduler 空闲后调用：检查目标 P，或保留 CPU 副本定向逐出 GPU。
+
+        首版只允许单条 FULL-KV 实验分支，避免共享分支和混合组件的隐式逐出。
+        除了复用正常 match 的边界拆分，所有检查都先于释放；绝不直接释放 Tensor。
+        """
+        cc = self.cache_controller
+        if (
+            self.disable
+            or not isinstance(self.tree_core, UnifiedTreeCore)
+            or self.tree_components != (ComponentType.FULL,)
+            or self.sidecar_pool_specs
+            or self.session.slots
+            or self.linker is not None
+            or cc is None
+            or cc.write_policy != "write_through"
+            or self.host_memory_mode != "cache"
+            or self.enable_storage
+        ):
+            raise ValueError(
+                "仅支持 Python TreeCore、无 sidecar/L3 的 FULL-KV write_through 缓存"
+            )
+        if (
+            self.ongoing_write_through
+            or self.ongoing_load_back
+            or cc.has_inflight_device_transfers()
+        ):
+            raise ValueError("备份或恢复尚未完成，不能读取稳定状态或逐出")
+        if action not in ("inspect", "demote"):
+            raise ValueError("未知实验操作")
+        if not prefix_ids or len(prefix_ids) % self.page_size:
+            raise ValueError("prefix_ids 必须非空且按 page_size 对齐")
+        # HTTP/IPC 输入是 list，而真实 serving 的树键统一使用 array('q')。
+        # RadixKey 不会自动转换；混用类型会触发 match_at 的断言并杀死 Scheduler。
+        try:
+            prefix_key = RadixKey(array("q", prefix_ids))
+        except (OverflowError, TypeError) as exc:
+            raise ValueError("prefix_ids 必须能表示为 int64 token 序列") from exc
+
+        # 显式建立零值，保证第一次 H2D 之前的 /metrics 也有可读取的基准。
+        metrics = self.metrics_collector
+        if metrics is not None:
+            metrics.load_back_num_bytes.labels(**metrics.labels)
+            metrics.load_back_num_tokens.labels(
+                **metrics.labels, pool=PoolName.KV.value
+            )
+            metrics.load_back_duration_seconds.labels(**metrics.labels)
+
+        def inspect():
+            # 标准 match 会在 P 处拆分节点，并保留正常的 LRU/引用和备份信息。
+            match = self.match_prefix(MatchPrefixParams(key=prefix_key))
+            node = self.tree_core.node_by_id(match.best_match_node)
+            path = []  # 从 P 末端向根遍历，不包含根。
+            while node.parent is not None:
+                path.append(node)
+                node = node.parent
+            host_tokens = sum(
+                len(node.component_data[ComponentType.FULL].host_value)
+                for node in path
+                if node.component_data[ComponentType.FULL].host_value is not None
+            )
+            device_free = self.token_to_kv_pool_allocator.available_size()
+            host_free = cc.mem_pool_host.available_size()
+            state = dict(
+                prefix_tokens=len(prefix_ids),
+                matched_tokens=match.full_kv_hit_length,
+                device_tokens=match.device_prefix_len,
+                host_hit_tokens=match.host_hit_length,
+                host_backed_tokens=host_tokens,
+                backup_complete=host_tokens == len(prefix_ids)
+                and all(
+                    node.write_through_pending_id is None
+                    and node.load_back_pending_id is None
+                    and node.component_data[ComponentType.FULL].host_value is not None
+                    and len(node.component_data[ComponentType.FULL].host_value)
+                    == len(node.key)
+                    for node in path
+                ),
+                device_free_tokens=device_free,
+                host_free_tokens=host_free,
+                device_used_tokens=self.token_to_kv_pool_allocator.size - device_free,
+                host_used_tokens=cc.mem_pool_host.size - host_free,
+                kv_bytes_per_token=int(cc.mem_pool_host.size_per_token),
+                demoted_tokens=0,
+            )
+            return state, path
+
+        before, path = inspect()
+        if action == "inspect":
+            return before
+        if not before["backup_complete"] or before["matched_tokens"] != len(prefix_ids):
+            raise ValueError("目标 Prefix 没有完整、已完成的 CPU 备份")
+
+        # P 可能还有 S₀ 子节点。先收集其后代，再统一预检，最后从叶子向根逐出。
+        descendants = []
+        stack = list(path[0].children.values())
+        while stack:
+            node = stack.pop()
+            descendants.append(node)
+            stack.extend(node.children.values())
+        order = list(reversed(descendants)) + path
+        for node in order:
+            data = node.component_data[ComponentType.FULL]
+            if len(node.children) > 1 or len(node.parent.children) > 1:
+                raise ValueError("存在额外共享分支，请清空后只预热一个实验输入")
+            if (
+                data.lock_ref
+                or data.host_lock_ref
+                or data.session_ref
+                or node.write_through_pending_id is not None
+                or node.load_back_pending_id is not None
+            ):
+                raise ValueError("目标分支仍有引用或异步操作，拒绝逐出")
+            if data.host_value is None or len(data.host_value) != len(node.key):
+                raise ValueError("目标分支或其后缀没有完整 CPU 副本")
+
+        tracker = {ComponentType.FULL: 0}
+        started = time.perf_counter()
+        for node in order:
+            if not node.evicted:  # 重复 demote 不重复释放槽位。
+                self._demote(node.id, tracker)
+        self.update_eviction_metrics(tracker[ComponentType.FULL], started)
+        after, _ = inspect()
+        if (
+            after["device_tokens"] != 0
+            or after["host_hit_tokens"] != len(prefix_ids)
+            or after["host_backed_tokens"] != len(prefix_ids)
+            or after["host_free_tokens"] != before["host_free_tokens"]
+            or after["device_free_tokens"] - before["device_free_tokens"]
+            != tracker[ComponentType.FULL]
+        ):
+            raise RuntimeError("Demote 后状态校验失败，请停止该次实验并检查缓存")
+        after["demoted_tokens"] = tracker[ComponentType.FULL]
+        return after
+
