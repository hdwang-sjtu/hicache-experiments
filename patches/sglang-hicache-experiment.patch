+def coordinate_hicache_experiment(cache, prefix_ids, action, idle, rank, gather):
+    """The injected gather is collective on every path, including local errors.
+
+    Scheduler control dispatch is serial: no request can run between preflight
+    agreement and execution. An execution error cannot roll back released slots;
+    return a fatal failure and require the experiment owner to stop the service.
+    """
+    local = dict(tp_rank=rank, ready=idle, error=None, state=None)
+    if idle:
+        try:
+            local["state"] = cache.experiment_control(
+                prefix_ids, action="preflight_demote" if action == "demote" else action)
+        except Exception as exc:
+            local["error"] = str(exc)
+    prepared = gather(local)
+    errors = [f"rank={v['tp_rank']}: {v['error']}" for v in prepared if v["error"]]
+    if errors:
+        return dict(success=False, ready=True, message="; ".join(errors),
+                    state={"ranks": {str(v["tp_rank"]): v for v in prepared}})
+    if not all(v["ready"] for v in prepared):
+        return dict(success=True, ready=False, message="等待所有 rank 空闲")
+    completed = prepared
+    if action == "demote":
+        try:
+            local["state"] = cache.experiment_control(prefix_ids, action="demote")
+        except Exception as exc:
+            local["error"] = str(exc)
+        completed = gather(local)
+        errors = [f"rank={v['tp_rank']}: {v['error']}" for v in completed if v["error"]]
+        if errors:
+            return dict(success=False, ready=True,
+                        message="部分 rank 执行失败，必须停止本次服务：" + "; ".join(errors),
+                        state={"ranks": {str(v["tp_rank"]): v for v in completed}})
+    ranks = {str(v["tp_rank"]): v["state"] for v in completed}
+    # Preserve single-rank consumers; multi-rank clients must inspect every rank.
+    state = dict(ranks["0"], ranks=ranks)
+    return dict(success=True, ready=True, state=state)
+
