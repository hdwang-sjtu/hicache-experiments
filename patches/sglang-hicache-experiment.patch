+    def experiment_control(self, prefix_ids: list[int], *, action: str) -> dict:
+        """Scheduler 空闲后调用：检查目标 P，或保留 CPU 副本定向逐出 GPU。
+
+        只允许单条 FULL 或 FULL+MAMBA 分支；混合模型必须在 P 处有完整状态。
+        除了复用正常 match 的边界拆分，所有检查都先于释放；绝不直接释放 Tensor。
+        """
+        cc = self.cache_controller
+        if (
+            self.disable
+            or not isinstance(self.tree_core, UnifiedTreeCore)
+            or set(self.tree_components) not in (
+                {ComponentType.FULL}, {ComponentType.FULL, ComponentType.MAMBA}
