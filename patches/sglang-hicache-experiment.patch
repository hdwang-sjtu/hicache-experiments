+    def handle_hicache_experiment(self, recv_req: HiCacheExperimentReqInput):
+        """只协调控制请求；树结构和槽位操作由缓存自身负责。"""
+        from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+
+        if not get_memory().enable_hicache_experiment:
+            return HiCacheExperimentReqOutput(success=False, message="实验接口未启用")
+        parallel = get_parallel()
+        if (
+            parallel.tp_size != 1
+            or parallel.pp_size != 1
+            or parallel.dp_size != 1
+            or not self.enable_hierarchical_cache
+            or not isinstance(self.tree_cache, UnifiedRadixCache)
+            or not self.spec_algorithm.is_none()
+            or self.disaggregation_mode != DisaggregationMode.NULL
+            or get_memory().enable_session_radix_cache
+        ):
+            return HiCacheExperimentReqOutput(
+                success=False,
+                message="仅支持无推测解码/会话缓存的 FULL KV 单卡 HiCache 实验",
+            )
+        # 包含 overlap 结果队列和 HiCache D2H/H2D；忙时返回，由 Driver 在计时外轮询。
+        if not self.is_fully_idle():
+            return HiCacheExperimentReqOutput(
+                success=True, message="等待请求与异步传输结束"
+            )
+        try:
+            state = self.tree_cache.experiment_control(
+                recv_req.prefix_ids, action=recv_req.action
+            )
+        except (ValueError, RuntimeError) as exc:
+            return HiCacheExperimentReqOutput(
+                success=False, ready=True, message=str(exc)
+            )
+        return HiCacheExperimentReqOutput(success=True, ready=True, state=state)
+
